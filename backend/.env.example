GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Set both to enable image understanding. Choose an available model for your account.
GEMINI_API_KEY=
GEMINI_MODEL=
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required in production: a random secret of at least 32 characters.
# Share only with invited testers; never add this to VITE_* variables.
BETA_ACCESS_TOKEN=
# Completed server-side turns older than this are removed during startup.
# Use 0 only when indefinite retention is an intentional operator decision.
ALIA_RETENTION_DAYS=30
# Optional absolute path, default backend/data/alia.db
# ALIA_DB_PATH=
