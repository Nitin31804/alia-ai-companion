# Required for streamed text replies.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: set both values to enable image understanding.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional for local use. Production requires at least 32 random characters.
BETA_ACCESS_TOKEN=

# Completed server-side turns older than this are removed during startup.
# Set to 0 only when an operator has chosen indefinite retention deliberately.
ALIA_RETENTION_DAYS=30

# Required only by compose.production.yml.
APP_DOMAIN=your-domain.example
